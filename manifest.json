{
  "manifest_version": 3,
  "name": "Limpar Dados do Site",
  "version": "1.2.0",
  "minimum_chrome_version": "96",
  "description": "Remove cookies, cache e armazenamentos do site aberto na aba atual.",
  "permissions": [
    "activeTab",
    "browsingData",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Limpar Dados do Site"
  }
}
